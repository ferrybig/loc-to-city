{
	"name": "@ferrybig/cgeodata-reader",
	"version": "0.1.0",
	"description": "Reverse geocoding without a database: resolves a latitude/longitude to its country, region and city from OpenStreetMap boundaries, reading a compact CGEODATA file. No dependencies; Node.js and browsers.",
	"keywords": [
		"reverse-geocoding",
		"geocoding",
		"geodata",
		"openstreetmap",
		"administrative-boundaries",
		"offline"
	],
	"license": "MIT",
	"author": "Fernando van Loenhout",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ferrybig/loc-to-city.git",
		"directory": "reader"
	},
	"homepage": "https://github.com/ferrybig/loc-to-city/tree/master/reader#readme",
	"bugs": "https://github.com/ferrybig/loc-to-city/issues",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"default": "./dist/node.js"
		},
		"./indexes": {
			"types": "./dist/indexes.d.ts",
			"default": "./dist/indexes.js"
		},
		"./format": {
			"types": "./dist/format.d.ts",
			"default": "./dist/format.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"cgeodata": "./dist/cli.js"
	},
	"files": [
		"dist",
		"!dist/**/*.map",
		"binary-format.md"
	],
	"scripts": {
		"build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
		"test": "node --test test/*.test.ts",
		"typecheck": "tsc -p tsconfig.test.json",
		"bench": "node --expose-gc bench/bench.ts",
		"docs": "typedoc",
		"prepack": "npm run build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@playwright/test": "^1.48.0",
		"@types/node": "^24.0.0",
		"typedoc": "0.28.20",
		"typescript": "^5.7.0"
	}
}

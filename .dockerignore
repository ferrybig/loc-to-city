.git/
.vscode/
node_modules/
*/dist/

# Large data files - only the one .bin the Dockerfile's DATASET build arg
# picks is needed at runtime. Every final .bin is let through so any can be
# picked; BuildKit only sends the context files a COPY actually uses.
data/
!data/03-final/*.bin

# OSM extracts (data/ is excluded above; this covers stray ones elsewhere)
*.pbf
*.pbf.part

# Test and e2e artifacts
playwright-report/
test-results/
demo/e2e/

# Python artifacts from old prototype
.venv/
__pycache__/
*.pyc
agent-resources/

# data/ is gitignored wholesale -- it's almost entirely large, reproducible
# build artifacts (raw downloads, osmium extractions, resolved geojson,
# rebuildable .bin files). Only a small, explicit allowlist of
# irreplaceable/spec files is un-ignored below. See
# data-ingest/PIPELINE-STAGES.md for the full directory layout and how
# each stage is produced.
data/*

!data/00-raw/
data/00-raw/*
!data/00-raw/orphan/
data/00-raw/orphan/*
!data/00-raw/orphan/README.md

# data/02-resolved/, data/03-final/*.bin (except appendix-a-example.bin)
# are entirely build artifacts now -- rebuild locally via
# prepare-world.ts / filter-by-scope.ts / build-world.sh + the compressor
# CLI rather than tracking them in git. appendix-a-example.bin is the one
# exception: it's hand-extracted from binary-format.md's own Appendix A
# hex dump, a reader/ spec fixture, not a rebuildable pipeline output.
!data/03-final/
data/03-final/*
!data/03-final/appendix-a-example.bin

*.pbf
*.pbf.part
.venv/
__pycache__/
*.pyc
agent-resources/

node_modules/
.docker-image-stamp
dist/
reader/docs/
playwright-report/
test-results/

cgeodata-demo.tar.gz

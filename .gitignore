data/*.o5m

# Stage 0/1: raw downloads and osmium-extracted boundaries -- entirely
# gitignored (large, reproducible via download-*.sh / extract-boundaries.sh,
# except data/00-raw/orphan/ -- see its README). nl_cities.geojson (43MB)
# is committed despite being in that same NOT-reproducible orphan/
# directory; eu_cities.geojson (313MB) is kept gitignored instead, since
# GitHub rejects pushes containing a 300MB+ blob in history -- see
# data/00-raw/orphan/README.md for the backup risk this creates and the
# planned fix (replace it with something derived from the World
# pipeline's own OSM extracts, or regenerate it some other way).
data/00-raw/osm/
data/00-raw/geonames/
data/00-raw/natural-earth/
data/00-raw/orphan/eu_cities.geojson
data/01-extracted/

# Stage 2: only the two multi-GB filtered-city files are gitignored --
# everything else in data/02-resolved/ (hierarchy/regions/country-polygons
# JSON, all small) is committed.
data/02-resolved/eu/cities-filtered.geojson
data/02-resolved/world/cities-filtered.geojsonseq

data/search-index/
*.pbf
*.pbf.part
.venv/
__pycache__/
*.pyc
agent-resources/

